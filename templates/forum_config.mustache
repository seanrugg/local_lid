{{!
    Forum LID configuration panel.

    Rendered into the forum settings area — either injected into
    mod_edit.php via a settings callback or shown on a dedicated
    forum settings tab.

    Context fields:
        forumid              int
        courseid             int
        enabled              bool     — current LID state for this forum
        has_data             bool     — true if analyses exist for this forum
        ajax_url             string   — ajax.php endpoint
        prompt_locked        bool     — site admin has locked the prompt
        can_edit_prompt      bool     — user has local/lid:editprompt
        prompt_value         string   — current active prompt text for this forum
        has_prompt_override  bool     — forum has its own prompt (not inherited)
        inherited_from       string   — 'course' | 'site' (where prompt comes from)
        discussion_model     string   — current model: independent_first | open_engagement | structured_debate
        discussion_models    array    — [{value, label, description, selected}] for selector
        competency_enabled   bool     — true if course-level competencies are enabled
        competency_site_ok   bool     — true if Moodle competency subsystem is enabled
        competency_mode      string   — 'inherit' | 'exclude' | 'specific'
        competency_ids_json  string   — JSON array of selected competency IDs (or '[]')
        course_competencies  array    — [{id, shortname, description, selected}] for multi-select
        has_competencies     bool     — true if course has linked competencies
}}
{{> local_lid/lid_styles}}

<div class="lid-forum-config"
     data-forumid="{{forumid}}"
     data-courseid="{{courseid}}"
     data-enabled="{{#enabled}}1{{/enabled}}{{^enabled}}0{{/enabled}}"
     data-has-data="{{#has_data}}1{{/has_data}}{{^has_data}}0{{/has_data}}"
     data-discussion-model="{{discussion_model}}"
     data-competency-mode="{{competency_mode}}"
     data-competency-ids="{{competency_ids_json}}"
     data-url="{{ajax_url}}"
     style="max-width:800px">

    {{! ── Section heading ─────────────────────────────────────────────── }}
    <div class="lid-panel-title" style="margin-bottom:16px">
        {{#str}}forum_config_heading, local_lid{{/str}}
    </div>

    {{! ── Enable/disable toggle ───────────────────────────────────────── }}
    <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:16px;
                padding:16px;background:var(--lid-surface);border:1px solid var(--lid-border);
                border-radius:var(--lid-radius)">

        <label class="lid-toggle-label"
               style="display:flex;align-items:center;gap:10px;cursor:pointer;flex:1">

            {{! Toggle track }}
            <span class="lid-toggle-track"
                  style="position:relative;display:inline-block;
                         width:40px;height:22px;flex-shrink:0">
                <input type="checkbox"
                       class="lid-forum-enable-toggle"
                       {{#enabled}}checked{{/enabled}}
                       style="position:absolute;opacity:0;width:100%;height:100%;
                              cursor:pointer;margin:0;z-index:1">
                <span class="lid-toggle-bg"
                      style="position:absolute;inset:0;border-radius:11px;
                             background:{{#enabled}}var(--lid-accent3){{/enabled}}{{^enabled}}var(--lid-dim){{/enabled}};
                             transition:background 0.2s">
                </span>
                <span class="lid-toggle-knob"
                      style="position:absolute;top:3px;
                             left:{{#enabled}}21px{{/enabled}}{{^enabled}}3px{{/enabled}};
                             width:16px;height:16px;border-radius:50%;
                             background:#fff;transition:left 0.2s;pointer-events:none">
                </span>
            </span>

            <span>
                <span style="font-size:13px;font-weight:500;color:var(--lid-text);display:block;margin-bottom:2px">
                    {{#str}}forum_config_enabled, local_lid{{/str}}
                </span>
                <span class="lid-mono" style="font-size:10px;color:var(--lid-muted)">
                    {{#str}}forum_config_enabled_desc, local_lid{{/str}}
                </span>
            </span>
        </label>

        <div class="lid-forum-config-status" style="flex-shrink:0;padding-top:4px"></div>
    </div>

    {{! ── Discussion model selector ───────────────────────────────────── }}
    {{! Only shown when LID is enabled. Hidden via lid-forum-model-section class. }}
    <div class="lid-forum-model-section{{^enabled}} lid-forum-prompt-hidden{{/enabled}}"
         style="margin-bottom:16px;padding:16px;background:var(--lid-surface);
                border:1px solid var(--lid-border);border-radius:var(--lid-radius)">

        <div class="lid-panel-title" style="margin-bottom:4px">
            {{#str}}forum_config_discussion_model, local_lid{{/str}}
        </div>

        <p class="lid-mono" style="font-size:10px;color:var(--lid-muted);
                                   margin-bottom:12px;line-height:1.6">
            {{#str}}forum_config_discussion_model_desc, local_lid{{/str}}
        </p>

        {{! LID analysis timing notice }}
        <div class="lid-notice lid-notice-info"
             style="margin-bottom:14px;padding:10px 12px;background:var(--lid-surface2);
                    border-left:3px solid var(--lid-accent);border-radius:4px;
                    font-size:10px;color:var(--lid-muted);line-height:1.6">
            {{#str}}dashboard_forum_lid_guidance, local_lid{{/str}}
        </div>

        {{! Model option cards }}
        <div class="lid-model-options"
             style="display:flex;flex-direction:column;gap:8px">

            {{#discussion_models}}
            <label class="lid-model-option{{#selected}} lid-model-option-selected{{/selected}}"
                   style="display:flex;align-items:flex-start;gap:12px;
                          padding:12px 14px;border-radius:var(--lid-radius);
                          border:1px solid {{#selected}}var(--lid-accent){{/selected}}{{^selected}}var(--lid-border){{/selected}};
                          background:{{#selected}}rgba(0,229,255,0.04){{/selected}}{{^selected}}var(--lid-surface2){{/selected}};
                          cursor:pointer;transition:border-color 0.15s,background 0.15s">

                <input type="radio"
                       class="lid-forum-model-radio"
                       name="lid_discussion_model_{{forumid}}"
                       value="{{value}}"
                       {{#selected}}checked{{/selected}}
                       style="margin-top:2px;flex-shrink:0;accent-color:var(--lid-accent)">

                <span style="flex:1">
                    <span style="font-size:12px;font-weight:600;color:var(--lid-text);
                                 display:block;margin-bottom:3px">
                        {{label}}
                    </span>
                    <span class="lid-mono" style="font-size:10px;color:var(--lid-muted);
                                                  line-height:1.5;display:block">
                        {{description}}
                    </span>
                </span>

            </label>
            {{/discussion_models}}

        </div>

        {{! Save model button — saves independently of the enable toggle }}
        <div style="margin-top:12px;display:flex;align-items:center;gap:10px">
            <button class="lid-btn lid-btn-primary lid-model-save-btn"
                    style="font-size:10px">
                Save assessment model
            </button>
            <span class="lid-model-save-status lid-mono"
                  style="font-size:10px;color:var(--lid-muted)"></span>
        </div>

    </div>

    {{! ── Competency selector ─────────────────────────────────────────── }}
    {{! Only shown when LID is enabled AND course competencies feature is active. }}
    {{#competency_site_ok}}
    <div class="lid-forum-competency-section{{^enabled}} lid-forum-prompt-hidden{{/enabled}}"
         style="margin-bottom:16px;padding:16px;background:var(--lid-surface);
                border:1px solid var(--lid-border);border-radius:var(--lid-radius)">

        <div class="lid-panel-title" style="margin-bottom:4px">
            {{#str}}forum_config_competencies_heading, local_lid{{/str}}
        </div>

        {{^competency_enabled}}
        {{! Competencies disabled at course level }}
        <p class="lid-mono" style="font-size:10px;color:var(--lid-muted);line-height:1.6">
            {{#str}}forum_config_competencies_disabled, local_lid{{/str}}
        </p>
        {{/competency_enabled}}

        {{#competency_enabled}}
        {{^has_competencies}}
        {{! No competencies linked to course }}
        <p class="lid-mono" style="font-size:10px;color:var(--lid-muted);line-height:1.6">
            {{#str}}forum_config_competencies_none_in_course, local_lid{{/str}}
        </p>
        {{/has_competencies}}

        {{#has_competencies}}
        <p class="lid-mono" style="font-size:10px;color:var(--lid-muted);
                                   margin-bottom:12px;line-height:1.6">
            {{#str}}forum_config_competencies_desc, local_lid{{/str}}
        </p>

        {{! Mode selector: inherit / exclude / specific }}
        <div class="lid-competency-mode-options"
             style="display:flex;flex-direction:column;gap:6px;margin-bottom:12px">

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;
                          font-size:12px;color:var(--lid-text)">
                <input type="radio" class="lid-competency-mode-radio"
                       name="lid_competency_mode_{{forumid}}"
                       value="inherit"
                       {{#competency_mode_inherit}}checked{{/competency_mode_inherit}}
                       style="accent-color:var(--lid-accent)">
                {{#str}}forum_config_competencies_inherit, local_lid{{/str}}
            </label>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;
                          font-size:12px;color:var(--lid-text)">
                <input type="radio" class="lid-competency-mode-radio"
                       name="lid_competency_mode_{{forumid}}"
                       value="exclude"
                       {{#competency_mode_exclude}}checked{{/competency_mode_exclude}}
                       style="accent-color:var(--lid-accent)">
                {{#str}}forum_config_competencies_exclude_all, local_lid{{/str}}
            </label>

            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;
                          font-size:12px;color:var(--lid-text)">
                <input type="radio" class="lid-competency-mode-radio"
                       name="lid_competency_mode_{{forumid}}"
                       value="specific"
                       {{#competency_mode_specific}}checked{{/competency_mode_specific}}
                       style="accent-color:var(--lid-accent)">
                {{#str}}forum_config_competencies_specific, local_lid{{/str}}
            </label>
        </div>

        {{! Competency checklist — only visible when mode = specific }}
        <div class="lid-competency-checklist{{^competency_mode_specific}} lid-forum-prompt-hidden{{/competency_mode_specific}}"
             style="margin-bottom:12px;padding:10px 14px;
                    background:var(--lid-surface2);border:1px solid var(--lid-border);
                    border-radius:4px;max-height:200px;overflow-y:auto">

            {{#course_competencies}}
            <label style="display:flex;align-items:flex-start;gap:8px;
                          padding:4px 0;cursor:pointer;font-size:11px;color:var(--lid-text)">
                <input type="checkbox"
                       class="lid-competency-checkbox"
                       value="{{id}}"
                       {{#selected}}checked{{/selected}}
                       style="margin-top:2px;accent-color:var(--lid-accent);flex-shrink:0">
                <span>
                    <strong>{{shortname}}</strong>
                    {{#description}}
                    <span class="lid-mono" style="font-size:10px;color:var(--lid-muted)">
                        — {{description}}
                    </span>
                    {{/description}}
                </span>
            </label>
            {{/course_competencies}}

        </div>

        {{! Save competencies button }}
        <div style="display:flex;align-items:center;gap:10px">
            <button class="lid-btn lid-btn-primary lid-competency-save-btn"
                    style="font-size:10px">
                Save competency settings
            </button>
            <span class="lid-competency-save-status lid-mono"
                  style="font-size:10px;color:var(--lid-muted)"></span>
        </div>
        {{/has_competencies}}
        {{/competency_enabled}}

    </div>
    {{/competency_site_ok}}

    {{! ── Prompt override section ─────────────────────────────────────── }}
    {{#can_edit_prompt}}
    <div class="lid-forum-prompt-section{{^enabled}} lid-forum-prompt-hidden{{/enabled}}"
         style="margin-top:4px">

        <div style="padding:16px;background:var(--lid-surface);
                    border:1px solid var(--lid-border);border-radius:var(--lid-radius)">

            <div class="lid-panel-title" style="margin-bottom:12px">
                {{#str}}forum_config_prompt, local_lid{{/str}}
                {{#has_prompt_override}}
                <span class="lid-count-badge lid-count-complete" style="margin-left:8px">
                    Forum override active
                </span>
                {{/has_prompt_override}}
                {{^has_prompt_override}}
                <span class="lid-mono" style="font-size:9px;color:var(--lid-muted);margin-left:8px">
                    Inheriting from {{inherited_from}}
                </span>
                {{/has_prompt_override}}
            </div>

            <p class="lid-mono" style="font-size:10px;color:var(--lid-muted);
                                       margin-bottom:12px;line-height:1.6">
                {{#str}}forum_config_prompt_desc, local_lid{{/str}}
            </p>

            {{! The prompt_editor partial is loaded here — it provides
                the textarea, file upload, save, and reset controls. }}
            <div class="lid-prompt-editor" data-courseid="{{courseid}}" data-locked="0">
                <textarea id="lid-prompt-textarea"
                          class="lid-prompt-textarea"
                          rows="12"
                          style="width:100%;font-family:'DM Mono',monospace;font-size:11px;
                                 line-height:1.6;padding:12px;resize:vertical;
                                 background:var(--lid-surface2);color:var(--lid-text);
                                 border:1px solid var(--lid-border);border-radius:4px">{{prompt_value}}</textarea>
            </div>

        </div>
    </div>
    {{/can_edit_prompt}}

    {{! ── Locked notice ───────────────────────────────────────────────── }}
    {{#prompt_locked}}
    <div class="lid-notice lid-notice-info" style="margin-top:4px">
        {{#str}}prompt_locked_notice, local_lid{{/str}}
    </div>
    {{/prompt_locked}}

    {{! ── No-permission read-only prompt view ─────────────────────────── }}
    {{^can_edit_prompt}}
    {{^prompt_locked}}
    {{#enabled}}
    <div style="margin-top:4px;padding:16px;background:var(--lid-surface);
                border:1px solid var(--lid-border);border-radius:var(--lid-radius)">
        <div class="lid-panel-title" style="margin-bottom:10px">
            Active prompt
            <span class="lid-mono" style="font-size:9px;color:var(--lid-muted);margin-left:8px">
                Inheriting from {{inherited_from}}
            </span>
        </div>
        <pre style="background:var(--lid-surface2);border:1px solid var(--lid-border);
                    border-radius:4px;padding:12px;font-family:'DM Mono',monospace;
                    font-size:10px;color:var(--lid-muted);line-height:1.6;
                    white-space:pre-wrap;word-break:break-word;max-height:200px;
                    overflow-y:auto">{{prompt_value}}</pre>
    </div>
    {{/enabled}}
    {{/prompt_locked}}
    {{/can_edit_prompt}}

</div>

<style>
.lid-forum-prompt-hidden { display: none; }
.lid-prompt-textarea:focus {
    border-color: var(--lid-accent) !important;
    box-shadow: 0 0 0 2px rgba(0,229,255,0.08);
}
.lid-model-option:hover {
    border-color: var(--lid-accent) !important;
    background: rgba(0,229,255,0.03) !important;
}
.lid-model-option-selected {
    border-color: var(--lid-accent) !important;
    background: rgba(0,229,255,0.04) !important;
}
</style>
