{{!
    Full LID analysis card — renders one complete Learning Intelligence Dashboard
    panel from a decoded LID JSON object.

    Layout (same for both compact and non-compact — Option B):
      Scores → CPI → Bloom's (6 across)
      2-col grid: Radar + DV stacked (col 1) | Competencies (col 2)
      Full-width: Timeline (2-col flow)
      Full-width: Assessment Notes / Instructor Notes
      Meta footer
}}
<div class="lid-card{{#compact}} lid-card-compact{{/compact}}" data-schema="{{schema_version}}">

    {{! ── Session header ──────────────────────────────────────────────── }}
    <div class="lid-session-header">
        <div class="lid-session-meta">
            <span class="lid-mono lid-muted">{{session_date}}</span>
            <span class="lid-sep">·</span>
            <span class="lid-mono lid-muted">{{session_source}}</span>
            <span class="lid-source-badge">{{session_source_type}}</span>
        </div>
        <div class="lid-session-title">{{session_title}}</div>
        <div class="lid-session-summary lid-muted">{{session_summary}}</div>
        <div class="lid-session-footer">
            <span class="lid-mono lid-muted">~{{session_duration}} min</span>
            {{#session_tags}}
                <span class="lid-tag lid-tag-cyan">{{tag}}</span>
            {{/session_tags}}
        </div>
    </div>

    {{! ── Score cards ─────────────────────────────────────────────────── }}
    <div class="lid-score-row">
        <div class="lid-score-card lid-score-cyan">
            <div class="lid-score-label">{{#str}}dashboard_competencies, local_lid{{/str}}</div>
            <div class="lid-score-value">{{domains_count}}</div>
            <div class="lid-score-sub">Distinct professional domains</div>
        </div>
        <div class="lid-score-card lid-score-purple">
            <div class="lid-score-label">Cognitive depth</div>
            <div class="lid-score-value">{{cognitive_depth}}</div>
            <div class="lid-score-sub">Analysis, synthesis &amp; meta-cognition</div>
        </div>
        <div class="lid-score-card lid-score-green">
            <div class="lid-score-label">Strategic thinking</div>
            <div class="lid-score-value">{{strategic_thinking}}%</div>
            <div class="lid-score-sub">Systems-level problem framing</div>
        </div>
        <div class="lid-score-card lid-score-orange">
            <div class="lid-score-label">Meta-cognition</div>
            <div class="lid-score-value">{{meta_cognition}}</div>
            <div class="lid-score-sub">Self-awareness of learning process</div>
        </div>
    </div>

    {{! ── Cognitive Performance Index panel ────────────────────────────── }}
    {{#has_cpi}}
    <div class="lid-cpi-panel">
        <div class="lid-cpi-header">
            <div class="lid-cpi-left">
                <div class="lid-score-label">Cognitive Performance Index</div>
                <div class="lid-cpi-score lid-cpi-{{cpi_color}}">{{cpi_score}}</div>
                <div class="lid-cpi-band lid-cpi-band-{{cpi_color}}">{{cpi_band}}</div>
            </div>
            <div class="lid-cpi-right">
                <div class="lid-cpi-bar-bg">
                    <div class="lid-cpi-bar-fill lid-comp-{{cpi_color}}"
                         style="width:0"
                         data-width="{{cpi_bar_width}}">
                    </div>
                </div>
                <div class="lid-cpi-desc">{{cpi_band_description}}</div>
            </div>
        </div>
        {{#has_cpi_components}}
        <div class="lid-cpi-components">
            {{#cpi_components}}
            <div class="lid-cpi-component">
                <div class="lid-cpi-comp-header">
                    <span class="lid-cpi-comp-label">{{label}}</span>
                    <span class="lid-mono" style="font-size:9px;color:var(--lid-muted)">
                        {{weight_pct}}% weight · {{score}} → {{contribution}} pts
                    </span>
                </div>
                <div class="lid-comp-bar-bg">
                    <div class="lid-comp-bar-fill lid-comp-cyan"
                         style="width:0;height:3px"
                         data-width="{{bar_width}}">
                    </div>
                </div>
            </div>
            {{/cpi_components}}
        </div>
        {{/has_cpi_components}}
        <div class="lid-mono" style="font-size:8px;color:var(--lid-dim);margin-top:8px;
                                     line-height:1.4;border-top:1px solid var(--lid-dim);
                                     padding-top:6px">
            {{cpi_calculation_note}}
        </div>
    </div>
    {{/has_cpi}}

    {{! ── Bloom's taxonomy grid ───────────────────────────────────────── }}
    <div class="lid-panel lid-panel-blooms" style="margin-bottom:16px">
        <div class="lid-panel-title">{{#str}}dashboard_blooms, local_lid{{/str}}</div>
        <div class="lid-blooms-grid">
            {{#blooms_progression}}
            <div class="lid-bloom-card{{^is_active}} lid-bloom-inactive{{/is_active}}">
                <div class="lid-bloom-num">0{{level}}</div>
                <div class="lid-bloom-icon">{{icon}}</div>
                <div class="lid-bloom-title">{{title}}</div>
                <div class="lid-bloom-desc">{{description}}</div>
                <div class="lid-bloom-dots">
                    <div class="lid-bloom-dot{{#dot1}} lid-dot-active lid-dot-{{dot_color}}{{/dot1}}"></div>
                    <div class="lid-bloom-dot{{#dot2}} lid-dot-active lid-dot-{{dot_color}}{{/dot2}}"></div>
                    <div class="lid-bloom-dot{{#dot3}} lid-dot-active lid-dot-{{dot_color}}{{/dot3}}"></div>
                    <div class="lid-bloom-dot{{#dot4}} lid-dot-active lid-dot-{{dot_color}}{{/dot4}}"></div>
                    <div class="lid-bloom-dot{{#dot5}} lid-dot-active lid-dot-{{dot_color}}{{/dot5}}"></div>
                </div>
            </div>
            {{/blooms_progression}}
        </div>
    </div>

    {{! ══════════════════════════════════════════════════════════════════ }}
    {{! ── MAIN CONTENT — 2-col Option B ────────────────────────────── }}
    {{! Col 1: Radar + DV stacked  |  Col 2: Competencies               }}
    {{! Timeline: full-width below the 2-col row                         }}
    {{! ══════════════════════════════════════════════════════════════════ }}

    <div class="lid-main-grid">

        {{! ── Col 1: Radar + DV/ROI stacked ───────────────────────────── }}
        <div class="lid-main-col">

            {{! Radar chart }}
            {{#has_radar}}
            <div class="lid-panel lid-panel-radar">
                <div class="lid-panel-title">{{#str}}dashboard_radar, local_lid{{/str}}</div>
                <div class="lid-radar-container">
                    <canvas class="lid-radar-canvas"
                            data-axes="{{radar_axes_json}}"
                            width="280" height="280"
                            aria-label="Competency radar chart">
                    </canvas>
                </div>
            </div>
            {{/has_radar}}

            {{! Discussion value (v1.2) — stacked under radar in col 1 }}
            {{#has_discussion_value}}
            <div class="lid-panel">
                <div class="lid-panel-title">{{#str}}dashboard_discussion_value, local_lid{{/str}}</div>

                <div class="lid-dv-stats">
                    {{#has_dci}}
                    <div class="lid-dv-stat">
                        <div class="lid-roi-label">{{#str}}dashboard_dci, local_lid{{/str}}</div>
                        <div class="lid-roi-value lid-cpi-{{dci_color}}">{{dci}}</div>
                        <div class="lid-cpi-bar-bg" style="margin-top:6px">
                            <div class="lid-cpi-bar-fill lid-comp-{{dci_color}}"
                                 style="width:0"
                                 data-width="{{dci_bar_width}}">
                            </div>
                        </div>
                    </div>
                    {{/has_dci}}

                    <div class="lid-dv-stat">
                        <div class="lid-roi-label">Participation depth</div>
                        <div class="lid-roi-value lid-readiness-{{participation_depth_color}}">{{participation_depth}}</div>
                        {{#dv_session_hours}}
                        <div class="lid-roi-desc">{{dv_session_hours}} hrs</div>
                        {{/dv_session_hours}}
                    </div>

                    {{#has_dci_components}}
                    <div class="lid-dv-components">
                        {{#dci_components}}
                        <div class="lid-dv-comp-row">
                            <span class="lid-cpi-comp-label" style="font-size:10px">{{label}}</span>
                            <span class="lid-mono" style="font-size:9px;color:var(--lid-muted)">{{score}}</span>
                        </div>
                        {{/dci_components}}
                    </div>
                    {{/has_dci_components}}
                </div>
            </div>
            {{/has_discussion_value}}

            {{! ROI (v1.0/v1.1) — stacked under radar in col 1 }}
            {{#has_roi}}
            <div class="lid-panel">
                <div class="lid-panel-title">{{#str}}dashboard_roi, local_lid{{/str}}</div>
                <div class="lid-dv-stats">
                    <div class="lid-dv-stat">
                        <div class="lid-roi-label">Est. knowledge value</div>
                        <div class="lid-roi-value">${{{knowledge_value}}}</div>
                    </div>
                    <div class="lid-dv-stat">
                        <div class="lid-roi-label">Time efficiency</div>
                        <div class="lid-roi-value">{{efficiency_mult}}×</div>
                        <div class="lid-roi-desc">~{{lms_hours}}hrs vs {{session_hours}}hrs</div>
                    </div>
                    <div class="lid-dv-stat">
                        <div class="lid-roi-label">Engagement</div>
                        <div class="lid-roi-value">{{engagement_score}}%</div>
                    </div>
                    <div class="lid-dv-stat">
                        <div class="lid-roi-label">Retention</div>
                        <div class="lid-roi-value">{{retention_pct}}%</div>
                    </div>
                    <div class="lid-dv-stat">
                        <div class="lid-roi-label">Readiness</div>
                        <div class="lid-roi-value lid-readiness-{{readiness_color}}">{{application_readiness}}</div>
                    </div>
                    <div class="lid-dv-stat">
                        <div class="lid-roi-label">EVI</div>
                        <div class="lid-roi-value">{{employer_value_index}}/10</div>
                    </div>
                </div>
            </div>
            {{/has_roi}}

        </div>{{! end .lid-main-col }}

        {{! ── Col 2: Competencies ─────────────────────────────────────── }}
        <div class="lid-panel lid-panel-comps">
            <div class="lid-panel-title">{{#str}}dashboard_competencies, local_lid{{/str}}</div>
            <div class="lid-comp-list">
                {{#competencies}}
                <div class="lid-comp-item">
                    <div class="lid-comp-header">
                        <span class="lid-comp-name">{{name}}</span>
                        <span class="lid-comp-score lid-mono">{{score}}%</span>
                    </div>
                    <div class="lid-comp-bar-bg">
                        <div class="lid-comp-bar-fill {{color_class}}"
                             style="width:0"
                             data-width="{{bar_width}}">
                        </div>
                    </div>
                    <div class="lid-comp-meta lid-mono">
                        {{#has_frameworks}}
                            {{#frameworks}}{{tag}} · {{/frameworks}}
                        {{/has_frameworks}}
                        Bloom's L{{bloom_level}} — {{bloom_label}}
                    </div>
                </div>
                {{/competencies}}
                {{^competencies}}
                <p class="lid-muted lid-mono" style="font-size:11px">
                    {{#str}}dashboard_nodata, local_lid{{/str}}
                </p>
                {{/competencies}}
            </div>
        </div>

        {{! ── Timeline (full-width below the 2-col row) ───────────────── }}
        {{#show_timeline}}
        {{#has_timeline}}
        <div class="lid-panel lid-panel-timeline">
            <div class="lid-panel-title">{{#str}}dashboard_timeline, local_lid{{/str}}</div>
            <div class="lid-timeline">
                {{#timeline}}
                <div class="lid-tl-item">
                    <div class="lid-tl-title">{{title}}</div>
                    <div class="lid-tl-desc">{{description}}</div>
                </div>
                {{/timeline}}
            </div>
        </div>
        {{/has_timeline}}
        {{/show_timeline}}

    </div>{{! end .lid-main-grid }}

    {{! ── Bottom row — Assessment / Instructor notes ──────────────────── }}
    <div class="lid-bottom-grid">

        {{! Employer value (v1.0 / v1.1 only) }}
        {{#has_employer_value}}
        <div class="lid-panel">
            <div class="lid-panel-title">{{#str}}dashboard_employer_value, local_lid{{/str}}</div>
            <div class="lid-value-list">
                {{#employer_value}}
                <div class="lid-value-item">
                    <div class="lid-value-icon">{{icon}}</div>
                    <div class="lid-value-text">
                        <strong>{{title}}</strong>
                        {{description}}
                    </div>
                </div>
                {{/employer_value}}
            </div>
        </div>
        {{/has_employer_value}}

        {{! Instructor notes (v1.2 only) }}
        {{#has_instructor_notes_content}}
        <div class="lid-panel">
            <div class="lid-panel-title">{{#str}}dashboard_instructor_notes, local_lid{{/str}}</div>
            {{#instructor_participation_summary}}
            <div class="lid-mono"
                 style="font-size:11px;color:var(--lid-text);line-height:1.7;margin-bottom:8px">
                <strong>Participation summary:</strong> {{instructor_participation_summary}}
            </div>
            {{/instructor_participation_summary}}
            {{#instructor_has_standout_moments}}
            <div style="margin-bottom:8px">
                <div class="lid-mono" style="font-size:10px;font-weight:700;color:var(--lid-text);margin-bottom:4px">Standout moments:</div>
                {{#instructor_standout_moments}}
                <div class="lid-mono"
                     style="font-size:10px;color:var(--lid-muted);line-height:1.6;
                            padding:4px 0;border-bottom:1px solid var(--lid-dim)">
                    {{#is_strength}}<span style="color:var(--lid-accent)">✦</span>{{/is_strength}}
                    {{#is_growth}}<span style="color:var(--lid-warn)">↑</span>{{/is_growth}}
                    {{observation}}
                </div>
                {{/instructor_standout_moments}}
            </div>
            {{/instructor_has_standout_moments}}
            {{#instructor_growth_indicators}}
            <div class="lid-mono"
                 style="font-size:11px;color:var(--lid-text);line-height:1.7;margin-bottom:8px">
                <strong>Growth indicators:</strong> {{instructor_growth_indicators}}
            </div>
            {{/instructor_growth_indicators}}
            {{#instructor_constructive_feedback}}
            <div class="lid-mono"
                 style="font-size:11px;color:var(--lid-text);line-height:1.7">
                <strong>Constructive feedback:</strong> {{instructor_constructive_feedback}}
            </div>
            {{/instructor_constructive_feedback}}
        </div>
        {{/has_instructor_notes_content}}

        {{! Portfolio (v1.0 / v1.1 only) }}
        {{#show_portfolio}}
        {{#has_portfolio}}
        <div class="lid-panel">
            <div class="lid-panel-title">{{#str}}dashboard_portfolio, local_lid{{/str}}</div>
            <div class="lid-cert-block">
                <div class="lid-cert-title">{{portfolio_title}}</div>
                <div class="lid-cert-sub lid-mono">{{portfolio_subtitle}}</div>
                <div class="lid-cert-tags">
                    {{#portfolio_tags}}
                    <span class="lid-tag lid-tag-cyan">{{tag}}</span>
                    {{/portfolio_tags}}
                </div>
            </div>
            {{#portfolio_formats}}
            <div class="lid-cert-tags" style="margin-top:10px">
                <span class="lid-tag lid-tag-{{color}}">{{label}}</span>
            </div>
            {{/portfolio_formats}}
        </div>
        {{/has_portfolio}}
        {{/show_portfolio}}

    </div>{{! end .lid-bottom-grid }}

    {{! ── Meta footer ─────────────────────────────────────────────────── }}
    {{#has_meta_notes}}
    <div class="lid-meta-notice">
        <span class="lid-mono" style="font-size:9px">{{meta_notes}}</span>
    </div>
    {{/has_meta_notes}}

</div>{{! end .lid-card }}
