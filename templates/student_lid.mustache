{{!
    Student LID tab page.
    Context: see classes/output/student_lid_page.php::export_for_template()
    All analysis cards and status badges arrive as pre-rendered HTML.
    Output with triple brackets to avoid escaping.

    use_native_theme     bool     -- true if native Moodle theme mode is enabled
}}
{{#use_native_theme}}
    {{> local_lid/lid_styles_native}}
{{/use_native_theme}}
{{^use_native_theme}}
    {{> local_lid/lid_styles}}
{{/use_native_theme}}

<div class="lid-page lid-page-student">

    {{! -- Page header ----------------------------------------------------- }}
    <div class="lid-page-header">
        <div class="lid-page-header-left" style="display:flex;align-items:center;gap:14px">
            {{{userpic}}}
            <div>
                <h2 class="lid-heading">{{fullname}}</h2>
                <div class="lid-mono lid-muted" style="font-size:10px;margin-top:3px">
                    {{coursename}}
                    {{#last_updated}}
                    <span class="lid-sep">&middot;</span>
                    {{#str}}dashboard_last_updated, local_lid, {{last_updated}}{{/str}}
                    {{/last_updated}}
                </div>
            </div>
        </div>
    </div>

    {{! -- Notices --------------------------------------------------------- }}
    {{#stale_notice}}
    <div class="lid-notice lid-notice-warn">
        {{#str}}dashboard_stale_notice, local_lid{{/str}}
    </div>
    {{/stale_notice}}

    {{! -- No data empty state --------------------------------------------- }}
    {{^has_data}}
    <div class="lid-empty-state">
        <div class="lid-empty-icon">&#x1F4CA;</div>
        <div class="lid-empty-title">No data yet</div>
        <div class="lid-empty-desc">{{nodata_notice}}</div>
    </div>
    {{/has_data}}

    {{#has_data}}

    {{! -- View tabs -------------------------------------------------------- }}
    <div class="lid-forum-tabs" id="lid-student-tabs" role="tablist">
        <button class="lid-forum-tab lid-forum-tab-active"
                role="tab" aria-selected="true"
                aria-controls="lid-student-aggregate"
                data-target="lid-student-aggregate">
            {{#str}}dashboard_student_allfora, local_lid{{/str}}
        </button>
        {{#forums}}
        <button class="lid-forum-tab"
                role="tab" aria-selected="false"
                aria-controls="lid-student-forum-{{forumid}}"
                data-target="lid-student-forum-{{forumid}}">
            {{forumname}}
            <span class="lid-tab-count">{{post_count}}</span>
        </button>
        {{/forums}}
    </div>

    {{! -- Cross-forum aggregate panel ------------------------------------- }}
    <div class="lid-tab-panel" id="lid-student-aggregate" role="tabpanel">
        {{#has_aggregate}}
        {{{aggregate_html}}}
        {{/has_aggregate}}
        {{^has_aggregate}}
        <div class="lid-notice lid-notice-info">
            {{#str}}dashboard_nodata, local_lid{{/str}}
        </div>
        {{/has_aggregate}}
    </div>

    {{! -- Per-forum panels ------------------------------------------------ }}
    {{#forums}}
    <div class="lid-tab-panel lid-tab-panel-hidden"
         id="lid-student-forum-{{forumid}}"
         role="tabpanel">

        <div class="lid-forum-summary-bar">
            <div class="lid-forum-summary-counts">
                <span class="lid-count-badge lid-count-complete">{{post_count}} posts</span>
                {{#pending_count}}
                <span class="lid-count-badge lid-count-pending">{{pending_count}} pending</span>
                {{/pending_count}}
            </div>
            <a href="{{forum_url}}" class="lid-btn lid-btn-secondary" style="font-size:10px">
                {{#str}}nav_forumdashboard, local_lid{{/str}} &rarr;
            </a>
        </div>

        {{! Student-forum aggregate card }}
        {{#has_student_lid}}
        {{{student_html}}}
        {{/has_student_lid}}
        {{^has_student_lid}}
        <div class="lid-notice lid-notice-info">
            {{#str}}dashboard_nodata, local_lid{{/str}}
        </div>
        {{/has_student_lid}}

        {{! Individual posts accordion }}
        <div class="lid-posts-section">
            <button class="lid-btn lid-btn-ghost lid-btn-full lid-js-toggle-posts"
                    aria-expanded="false"
                    aria-controls="lid-student-posts-{{forumid}}"
                    data-target="lid-student-posts-{{forumid}}">
                &#x25BC; {{#str}}dashboard_student_viewpost, local_lid{{/str}} ({{post_count}})
            </button>
            <div class="lid-student-posts lid-student-posts-hidden"
                 id="lid-student-posts-{{forumid}}">
                {{#posts}}
                <div class="lid-post-row">
                    <div class="lid-post-header">
                        <div class="lid-post-info">
                            <span class="lid-post-subject">{{subject}}</span>
                            <span class="lid-mono lid-muted" style="font-size:10px">{{posted_date}}</span>
                        </div>
                        <div class="lid-post-actions">
                            {{{status_html}}}
                        </div>
                    </div>
                    {{#has_analysis}}
                    <div class="lid-post-card-wrapper">
                        {{{analysis_html}}}
                    </div>
                    {{/has_analysis}}
                </div>
                {{/posts}}
            </div>
        </div>

    </div>
    {{/forums}}

    {{/has_data}}

</div>
