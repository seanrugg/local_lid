{{!
    Forum LID tab page.
    Context: see classes/output/forum_lid_page.php::export_for_template()

    All analysis cards and status badges arrive as pre-rendered HTML.
    Output with triple brackets to avoid escaping.

    Context fields:
        forumid              int
        courseid             int
        forumname            string
        lid_enabled          bool
        disabled_notice      string
        can_trigger          bool
        trigger_url          string
        analysis_pending     bool     — true if a batch is currently queued/processing
        stale_notice         bool     — true if any student has posted since last run
        has_aggregate        bool
        aggregate_html       string   — pre-rendered forum aggregate card HTML
        last_updated         string   — human-readable datetime or ''
        discussion_model_label string — human-readable label for the active model
        students             array
          userid             int
          fullname           string
          userpic            string   — HTML img tag
          student_url        string
          post_count         int      — total posts in this forum
          pending_count      int
          error_count        int
          is_stale           bool     — student has new posts since last analysis
          is_pending         bool     — student analysis in queue
          cpi_score          int|''   — CPI integer 70–145, or '' if no analysis
          cpi_band           string   — 'developing'|'progressing'|'performing'|'advanced'|''
          top_bloom          int|0
          top_bloom_label    string
          has_student_lid    bool
          student_html       string   — pre-rendered student_forum card HTML
          threads            array
            thread_id        int
            thread_name      string
            thread_html      string   — pre-rendered thread card HTML (or '')
            has_analysis     bool
            status_html      string   — pre-rendered status badge HTML
}}
{{> local_lid/lid_styles}}

<div class="lid-page lid-page-forum">

    {{! ── Page header ─────────────────────────────────────────────────── }}
    <div class="lid-page-header">
        <div class="lid-page-header-left">
            <h2 class="lid-heading">{{#str}}dashboard_forum_title, local_lid{{/str}}</h2>
            <div class="lid-mono lid-muted" style="font-size:10px;margin-top:4px">
                {{forumname}}
                {{#discussion_model_label}}
                <span class="lid-sep">·</span>
                {{#str}}dashboard_forum_discussion_model, local_lid, {{discussion_model_label}}{{/str}}
                {{/discussion_model_label}}
                {{#last_updated}}
                <span class="lid-sep">·</span>
                {{#str}}dashboard_last_updated, local_lid, {{last_updated}}{{/str}}
                {{/last_updated}}
            </div>
        </div>
        <div class="lid-page-header-actions">
            {{#can_trigger}}
            <button class="lid-btn lid-btn-secondary lid-js-trigger-forum"
                    data-forumid="{{forumid}}"
                    data-courseid="{{courseid}}"
                    data-url="{{trigger_url}}">
                {{#str}}dashboard_forum_reanalyse_all, local_lid{{/str}}
            </button>
            {{/can_trigger}}
        </div>
    </div>

    {{! ── LID timing guidance notice ─────────────────────────────────── }}
    {{#can_trigger}}
    <div class="lid-notice lid-notice-info"
         style="margin-bottom:12px;font-size:10px;line-height:1.6;
                border-left:3px solid var(--lid-accent);
                background:var(--lid-surface2)">
        {{#str}}dashboard_forum_lid_guidance, local_lid{{/str}}
    </div>
    {{/can_trigger}}

    {{! ── Notices ─────────────────────────────────────────────────────── }}
    {{^lid_enabled}}
    <div class="lid-notice lid-notice-warn">{{disabled_notice}}</div>
    {{/lid_enabled}}

    {{#analysis_pending}}
    <div class="lid-notice lid-notice-info">
        {{#str}}dashboard_forum_analysis_pending, local_lid{{/str}}
    </div>
    {{/analysis_pending}}

    {{#stale_notice}}
    <div class="lid-notice lid-notice-warn">
        {{#str}}dashboard_forum_stale_notice, local_lid{{/str}}
    </div>
    {{/stale_notice}}

    {{#lid_enabled}}

    {{! ── View tabs: aggregate + one per learner ─────────────────────── }}
    <div class="lid-forum-tabs" id="lid-forum-tabs" role="tablist">
        <button class="lid-forum-tab lid-forum-tab-active"
                role="tab" aria-selected="true"
                aria-controls="lid-forum-aggregate"
                data-target="lid-forum-aggregate">
            {{#str}}dashboard_forum_aggregate, local_lid{{/str}}
        </button>
        {{#students}}
        <button class="lid-forum-tab lid-forum-tab-learner"
                role="tab" aria-selected="false"
                aria-controls="lid-learner-panel-{{userid}}"
                data-target="lid-learner-panel-{{userid}}"
                title="{{fullname}} · {{post_count}} posts{{#cpi_score}} · CPI {{cpi_score}}{{/cpi_score}}">
            <span class="lid-tab-learner-name">{{fullname}}</span>
            {{#cpi_score}}
            <span class="lid-tab-cpi lid-tab-cpi-{{cpi_band}}">{{cpi_score}}</span>
            {{/cpi_score}}
            {{^cpi_score}}
            <span class="lid-tab-cpi lid-tab-cpi-none">–</span>
            {{/cpi_score}}
        </button>
        {{/students}}
    </div>

    {{! ── Forum aggregate panel ──────────────────────────────────────── }}
    <div class="lid-tab-panel" id="lid-forum-aggregate" role="tabpanel">
        {{#has_aggregate}}
        {{{aggregate_html}}}
        {{/has_aggregate}}
        {{^has_aggregate}}
        <div class="lid-notice lid-notice-info">
            {{#str}}dashboard_nodata, local_lid{{/str}}
        </div>
        {{/has_aggregate}}
    </div>

    {{! ── Per-learner panels (one per student, hidden by default) ──── }}
    {{#students}}
    <div class="lid-tab-panel lid-tab-panel-hidden" id="lid-learner-panel-{{userid}}" role="tabpanel">

        <div class="lid-student-row" id="lid-student-{{userid}}">

            <div class="lid-student-header">
                <div class="lid-student-avatar">{{{userpic}}}</div>
                <div class="lid-student-info">
                    <div class="lid-student-name">
                        {{fullname}}
                        {{#is_stale}}
                        <span class="lid-count-badge lid-count-pending"
                              style="font-size:9px;margin-left:6px;vertical-align:middle">
                            {{#str}}status_stale, local_lid{{/str}}
                        </span>
                        {{/is_stale}}
                        {{#is_pending}}
                        <span class="lid-count-badge"
                              style="font-size:9px;margin-left:6px;vertical-align:middle;
                                     background:var(--lid-surface2);color:var(--lid-muted);
                                     border:1px solid var(--lid-border)">
                            {{#str}}status_pending, local_lid{{/str}}
                        </span>
                        {{/is_pending}}
                    </div>
                    <div class="lid-student-meta lid-mono">
                        <span class="lid-count-badge lid-count-complete">{{post_count}} posts</span>
                        {{#pending_count}}<span class="lid-count-badge lid-count-pending">{{pending_count}} pending</span>{{/pending_count}}
                        {{#error_count}}<span class="lid-count-badge lid-count-error">{{error_count}} error</span>{{/error_count}}
                        {{#cpi_score}}<span class="lid-score-inline">CPI {{cpi_score}}<span class="lid-mono" style="font-size:9px;color:var(--lid-muted);margin-left:3px">{{cpi_band}}</span></span>{{/cpi_score}}
                        {{#top_bloom}}<span class="lid-bloom-badge">Bloom's L{{top_bloom}} — {{top_bloom_label}}</span>{{/top_bloom}}
                    </div>
                </div>
                <div class="lid-student-actions">
                    <a href="{{student_url}}" class="lid-btn lid-btn-secondary" style="font-size:10px">
                        {{#str}}dashboard_forum_viewlearner, local_lid{{/str}}
                    </a>
                    {{#threads}}
                    <button class="lid-btn lid-btn-ghost lid-js-toggle-posts"
                            aria-expanded="false"
                            aria-controls="lid-threads-{{userid}}"
                            data-target="lid-threads-{{userid}}">
                        ▼ {{#str}}dashboard_forum_thread_heading, local_lid{{/str}}
                    </button>
                    {{/threads}}
                </div>
            </div>

            {{! Student forum LID card — primary analysis unit }}
            {{#has_student_lid}}
            <div class="lid-student-lid-preview">
                {{{student_html}}}
            </div>
            {{/has_student_lid}}
            {{^has_student_lid}}
            {{#is_pending}}
            <div class="lid-notice lid-notice-info" style="margin:8px 0;font-size:10px">
                {{#str}}dashboard_forum_thread_pending, local_lid{{/str}}
            </div>
            {{/is_pending}}
            {{/has_student_lid}}

            {{! Thread cards accordion — collapsed by default }}
            {{#threads}}
            <div class="lid-student-posts lid-student-posts-hidden"
                 id="lid-threads-{{userid}}">

                {{#threads}}
                <div class="lid-post-row">
                    <div class="lid-post-header">
                        <div class="lid-post-info">
                            <span class="lid-post-subject">{{thread_name}}</span>
                        </div>
                        <div class="lid-post-actions">
                            {{{status_html}}}
                        </div>
                    </div>
                    {{#has_analysis}}
                    <div class="lid-post-card-wrapper">
                        {{{thread_html}}}
                    </div>
                    {{/has_analysis}}
                </div>
                {{/threads}}

            </div>
            {{/threads}}

        </div>{{! end .lid-student-row }}

    </div>{{! end per-learner panel }}
    {{/students}}

    {{/lid_enabled}}

</div>

{{! ── Learner tab styling ────────────────────────────────────────────── }}
<style>
/* Scrollable tab bar for many learners */
.lid-forum-tabs {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    gap: 2px;
    padding-bottom: 2px;
    scrollbar-width: thin;
}
.lid-forum-tabs::-webkit-scrollbar {
    height: 4px;
}
.lid-forum-tabs::-webkit-scrollbar-thumb {
    background: var(--lid-border, #333);
    border-radius: 2px;
}

/* Learner tab compact styling */
.lid-forum-tab-learner {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 5px;
    max-width: 180px;
    white-space: nowrap;
    padding: 6px 10px;
    font-size: 11px;
}
.lid-tab-learner-name {
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
    display: inline-block;
}
.lid-tab-cpi {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    min-width: 28px;
    padding: 1px 5px;
    border-radius: 3px;
    font-family: var(--lid-font-mono, 'JetBrains Mono', monospace);
}
.lid-tab-cpi-exceptional { background: var(--lid-accent, #00e5c8); color: #0a0e14; }
.lid-tab-cpi-advanced    { background: #7c3aed; color: #fff; }
.lid-tab-cpi-progressing { background: #2563eb; color: #fff; }
.lid-tab-cpi-developing  { background: var(--lid-surface2, #1a1f2a); color: var(--lid-muted, #6b7280); border: 1px solid var(--lid-border, #333); }
.lid-tab-cpi-foundational { background: var(--lid-surface2, #1a1f2a); color: var(--lid-muted, #6b7280); border: 1px solid var(--lid-border, #333); }
.lid-tab-cpi-none        { background: transparent; color: var(--lid-muted, #6b7280); font-size: 9px; }

/* Active learner tab highlight */
.lid-forum-tab-learner.lid-forum-tab-active {
    border-bottom-color: var(--lid-accent, #00e5c8);
}
</style>
