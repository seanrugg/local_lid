{{!
    Forum LID tab page.

    Context: see classes/output/forum_lid_page.php::export_for_template()
}}
{{> local_lid/lid_styles}}

<div class="lid-page lid-page-forum">

    {{! ── Page header ─────────────────────────────────────────────────── }}
    <div class="lid-page-header">
        <div class="lid-page-header-left">
            <h2 class="lid-heading">{{#str}}dashboard_forum_title, local_lid{{/str}}</h2>
            <div class="lid-mono lid-muted" style="font-size:10px;margin-top:4px">
                {{forumname}}
                {{#last_updated}}
                <span class="lid-sep">·</span>
                {{#str}}dashboard_last_updated, local_lid, {{last_updated}}{{/str}}
                {{/last_updated}}
            </div>
        </div>
        <div class="lid-page-header-actions">
            {{#can_trigger}}
            <button class="lid-btn lid-btn-secondary lid-trigger-forum"
                    data-forumid="{{forumid}}"
                    data-courseid="{{courseid}}"
                    data-url="{{trigger_url}}">
                {{#str}}dashboard_forum_reanalyse_all, local_lid{{/str}}
            </button>
            {{/can_trigger}}
        </div>
    </div>

    {{! ── Notices ─────────────────────────────────────────────────────── }}
    {{^lid_enabled}}
    <div class="lid-notice lid-notice-warn">{{disabled_notice}}</div>
    {{/lid_enabled}}

    {{#stale_notice}}
    <div class="lid-notice lid-notice-warn">
        {{#str}}dashboard_stale_notice, local_lid{{/str}}
    </div>
    {{/stale_notice}}

    {{#lid_enabled}}

    {{! ── View tabs: Aggregate / Students ────────────────────────────── }}
    <div class="lid-forum-tabs" role="tablist">
        <button class="lid-forum-tab lid-forum-tab-active"
                role="tab" aria-selected="true"
                aria-controls="lid-forum-aggregate"
                data-target="lid-forum-aggregate">
            {{#str}}dashboard_forum_aggregate, local_lid{{/str}}
        </button>
        <button class="lid-forum-tab"
                role="tab" aria-selected="false"
                aria-controls="lid-forum-students"
                data-target="lid-forum-students">
            {{#str}}dashboard_forum_students, local_lid{{/str}}
            <span class="lid-tab-count">{{#students}}{{/students}}</span>
        </button>
    </div>

    {{! ── Aggregate panel ────────────────────────────────────────────── }}
    <div class="lid-tab-panel" id="lid-forum-aggregate" role="tabpanel">
        {{#has_aggregate}}
        {{> local_lid/analysis_card aggregate_json}}
        {{/has_aggregate}}
        {{^has_aggregate}}
        <div class="lid-notice lid-notice-info">
            {{#str}}dashboard_nodata, local_lid{{/str}}
        </div>
        {{/has_aggregate}}
    </div>

    {{! ── Student contributions panel ───────────────────────────────── }}
    <div class="lid-tab-panel lid-tab-panel-hidden" id="lid-forum-students" role="tabpanel">

        {{^students}}
        <div class="lid-notice lid-notice-info">
            {{#str}}dashboard_forum_noposts, local_lid{{/str}}
        </div>
        {{/students}}

        {{#students}}
        <div class="lid-student-row" data-userid="{{userid}}">

            {{! Student summary header }}
            <div class="lid-student-header">
                <div class="lid-student-avatar">{{{userpic}}}</div>
                <div class="lid-student-info">
                    <div class="lid-student-name">{{fullname}}</div>
                    <div class="lid-student-meta lid-mono">
                        <span class="lid-count-badge lid-count-complete">{{post_count}} posts</span>
                        {{#pending_count}}<span class="lid-count-badge lid-count-pending">{{pending_count}} pending</span>{{/pending_count}}
                        {{#error_count}}<span class="lid-count-badge lid-count-error">{{error_count}} error</span>{{/error_count}}
                        {{#top_bloom}}
                        <span class="lid-bloom-badge">Bloom's L{{top_bloom}} — {{top_bloom_label}}</span>
                        {{/top_bloom}}
                        <span class="lid-score-inline">Top score: {{top_score}}%</span>
                    </div>
                </div>
                <div class="lid-student-actions">
                    <a href="{{student_url}}" class="lid-btn lid-btn-secondary" style="font-size:10px">
                        {{#str}}dashboard_forum_viewstudent, local_lid{{/str}}
                    </a>
                    <button class="lid-toggle-posts lid-btn lid-btn-ghost"
                            aria-expanded="false"
                            aria-controls="lid-student-posts-{{userid}}">
                        ▼ Posts
                    </button>
                </div>
            </div>

            {{! Student LID summary card (compact) }}
            {{#has_student_lid}}
            <div class="lid-student-lid-preview">
                {{> local_lid/analysis_card student_json compact=true show_portfolio=false show_timeline=false}}
            </div>
            {{/has_student_lid}}

            {{! Individual posts accordion }}
            <div class="lid-student-posts lid-student-posts-hidden"
                 id="lid-student-posts-{{userid}}">
                {{#posts}}
                <div class="lid-post-row" data-postid="{{postid}}" data-analysisid="">

                    <div class="lid-post-header">
                        <div class="lid-post-info">
                            <span class="lid-post-subject">{{subject}}</span>
                            <span class="lid-mono lid-muted" style="font-size:10px">{{posted_date}}</span>
                        </div>
                        <div class="lid-post-actions">
                            {{> local_lid/status_badge}}
                            {{#can_trigger}}
                            <button class="lid-btn lid-btn-ghost lid-reanalyse-post"
                                    data-url="{{reanalyse_url}}"
                                    style="font-size:10px">
                                {{#str}}dashboard_forum_reanalyse, local_lid{{/str}}
                            </button>
                            {{/can_trigger}}
                        </div>
                    </div>

                    {{! Post analysis card — shown only when complete }}
                    {{#has_analysis}}
                    <div class="lid-post-card-wrapper">
                        {{> local_lid/analysis_card analysis_json compact=true show_portfolio=false show_timeline=false}}
                    </div>
                    {{/has_analysis}}

                </div>
                {{/posts}}
            </div>

        </div>
        {{/students}}

    </div>{{! end students panel }}

    {{/lid_enabled}}

</div>{{! end .lid-page }}

<script>
require(['local_lid/dashboard'], function(Dashboard) {
    Dashboard.initForumPage({
        forumid:    {{forumid}},
        courseid:   {{courseid}},
        triggerUrl: '{{trigger_url}}'
    });
});
</script>
