{{!
    Course LID report page.

    Context: see classes/output/course_lid_page.php::export_for_template()
}}
{{> local_lid/lid_styles}}

<div class="lid-page lid-page-course">

    {{! ── Page header ─────────────────────────────────────────────────── }}
    <div class="lid-page-header">
        <div class="lid-page-header-left">
            <h2 class="lid-heading">{{#str}}dashboard_course_title, local_lid{{/str}}</h2>
            <div class="lid-mono lid-muted" style="font-size:10px;margin-top:4px">
                {{coursename}}
                {{#last_updated}}
                <span class="lid-sep">·</span>
                {{#str}}dashboard_last_updated, local_lid, {{last_updated}}{{/str}}
                {{/last_updated}}
            </div>
        </div>
        {{#can_trigger}}
        <div class="lid-page-header-actions">
            <button class="lid-btn lid-btn-secondary lid-trigger-forum-all"
                    data-courseid="{{courseid}}"
                    data-url="{{trigger_url}}">
                {{#str}}dashboard_forum_reanalyse_all, local_lid{{/str}}
            </button>
        </div>
        {{/can_trigger}}
    </div>

    {{! ── Notices ─────────────────────────────────────────────────────── }}
    {{#stale_notice}}
    <div class="lid-notice lid-notice-warn">
        {{#str}}dashboard_stale_notice, local_lid{{/str}}
    </div>
    {{/stale_notice}}

    {{! ── No forums state ─────────────────────────────────────────────── }}
    {{^haslid}}
    <div class="lid-empty-state">
        <div class="lid-empty-icon">📊</div>
        <div class="lid-empty-title">No data yet</div>
        <div class="lid-empty-desc">{{noforums_notice}}</div>
    </div>
    {{/haslid}}

    {{! ── Dashboard content ───────────────────────────────────────────── }}
    {{#haslid}}

    {{! Forum tabs }}
    <div class="lid-forum-tabs" role="tablist" aria-label="{{#str}}dashboard_course_allfora, local_lid{{/str}}">
        {{#has_aggregate}}
        <button class="lid-forum-tab lid-forum-tab-active"
                role="tab"
                aria-selected="true"
                aria-controls="lid-panel-aggregate"
                data-target="lid-panel-aggregate">
            {{#str}}dashboard_course_allfora, local_lid{{/str}}
            <span class="lid-tab-count">{{#forums}}{{/forums}}</span>
        </button>
        {{/has_aggregate}}
        {{#forums}}
        <button class="lid-forum-tab"
                role="tab"
                aria-selected="false"
                aria-controls="lid-panel-forum-{{forumid}}"
                data-target="lid-panel-forum-{{forumid}}">
            {{forumname}}
            <span class="lid-tab-badge{{#pending_count}} lid-tab-badge-warn{{/pending_count}}{{#error_count}} lid-tab-badge-error{{/error_count}}">
                {{post_count}}
            </span>
        </button>
        {{/forums}}
    </div>

    {{! Aggregate panel }}
    {{#has_aggregate}}
    <div class="lid-tab-panel" id="lid-panel-aggregate" role="tabpanel">
        {{#str}}dashboard_course_allfora, local_lid{{/str}}
        {{> local_lid/analysis_card aggregate_json}}
    </div>
    {{/has_aggregate}}
    {{^has_aggregate}}
    <div class="lid-tab-panel" id="lid-panel-aggregate" role="tabpanel">
        <div class="lid-notice lid-notice-info">
            {{#str}}dashboard_nodata, local_lid{{/str}}
        </div>
    </div>
    {{/has_aggregate}}

    {{! Per-forum panels }}
    {{#forums}}
    <div class="lid-tab-panel lid-tab-panel-hidden" id="lid-panel-forum-{{forumid}}" role="tabpanel">

        {{! Forum summary bar }}
        <div class="lid-forum-summary-bar">
            <div class="lid-forum-summary-counts">
                <span class="lid-count-badge lid-count-complete">{{post_count}} complete</span>
                {{#pending_count}}
                <span class="lid-count-badge lid-count-pending">{{pending_count}} pending</span>
                {{/pending_count}}
                {{#error_count}}
                <span class="lid-count-badge lid-count-error">{{error_count}} error</span>
                {{/error_count}}
            </div>
            <a href="{{view_url}}" class="lid-btn lid-btn-secondary" style="font-size:10px">
                {{#str}}nav_forumdashboard, local_lid{{/str}} →
            </a>
        </div>

        {{! Forum aggregate dashboard }}
        {{#has_analysis}}
        {{> local_lid/analysis_card analysis_json}}
        {{/has_analysis}}
        {{^has_analysis}}
        <div class="lid-notice lid-notice-info">
            {{#str}}dashboard_nodata, local_lid{{/str}}
        </div>
        {{/has_analysis}}

    </div>
    {{/forums}}

    {{/haslid}}

</div>{{! end .lid-page }}

<script>
require(['local_lid/dashboard'], function(Dashboard) {
    Dashboard.initCoursePage({
        courseid: {{courseid}},
        triggerUrl: '{{trigger_url}}'
    });
});
</script>
